#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
run

The write_file test of Man_In_Grey's file instruction language. It copies
the promoted Man_In_Grey, from $REPO_HOME/consumer, into its scratchpad
directory, puts constraints of its own at the top of the copy's
guard_file.py, allowing the files it expects, and runs that copy through
the file language's gate, not setuid. It checks:

  run_1      orchestrate composer/: each composer's file written, and
             out/obsolete.conf, made by the test beforehand, unlinked; the
             files are compared with expected/run_1
  run_2      orchestrate composer/ again: replace_keep files kept as backups named
             <file>.YYYYMMDDTHHMMSSZ, the replace file overwritten with no
             backup; compared with expected/run_2
  create     orchestrate composer_create/new.py: a file opened in create mode is written
             once, and a second run is refused by the guard's filesystem check
  refused    orchestrate composer_refused/: a journal opening one allowed file and one the
             constraints do not allow is refused whole by the guard's constraint check
  argument   orchestrate composer_argument/: a composer giving a wrong mode fails when it
             places the instruction, and no journal reaches the gate
  writable   orchestrate a composer directory holding a composer other accounts can write:
             the orchestrator refuses to run it
  check_only orchestrate composer/ with check_only: the guard approves the journal, and the
             interpreter is not run
  limit      orchestrate composer/ with a file size limit the gate cannot raise: the gate
             refuses before starting the guard

A refused run is to leave every file as it was. Backup names carry the time
of the run, so names are compared with the time replaced by the letters
YYYYMMDDTHHMMSSZ. Content, mode and owner are compared too.

The test reads consumer/ and writes only in its scratchpad directory,
$REPO_HOME/tester/scratchpad/write_file, where it runs its copy of
Man_In_Grey from tree/.

Usage: run <command>
  help | -h | --help   print this message (also printed when given no arguments)
  test                 run the test; the exit status is 0 only when every check passes
  clean                delete the test's scratchpad directory
"""

import sys ,os ,re ,stat ,json ,shutil ,subprocess ,getpass ,resource
from pathlib import Path

TEST_NAME = "write_file"
TEST_DPATH = Path(__file__).resolve().parent

OUTPUT_DIR = ("out" ,"out/net" ,"out/web")

# the files the constraints allow: (directory under the scratchpad, name, modes, permission)
ALLOWED = (
  ("out" ,"unbound_conf" ,["replace_keep"] ,"0444")
  ,("out/net" ,"unbound.conf" ,["replace"] ,"0444")
  ,("out/web" ,"nginx.conf" ,["replace_keep"] ,"0644")
  ,("out" ,"obsolete.conf" ,["unlink"] ,"0644")
  ,("out" ,"new.conf" ,["create"] ,"0600")
)

MODE = {
  "run_1": {
    "out/unbound_conf": 0o444
    ,"out/net/unbound.conf": 0o444
    ,"out/web/nginx.conf": 0o644
  },
  "run_2": {
    "out/unbound_conf": 0o444
    ,"out/unbound_conf.YYYYMMDDTHHMMSSZ": 0o444
    ,"out/net/unbound.conf": 0o444
    ,"out/web/nginx.conf": 0o644
    ,"out/web/nginx.conf.YYYYMMDDTHHMMSSZ": 0o644
  },
}

TIME_SUFFIX = re.compile(r"\.\d{8}T\d{6}Z(\.\d+)?$")
TIME_PLACEHOLDER = ".YYYYMMDDTHHMMSSZ"


# --------------------------------------------------------------------------------
# the log

TAG_WIDTH = 10

class Log:
  def __init__(self):
    self.count = {"passed": 0 ,"failed": 0}

  def check(self ,passed ,what ,detail=None):
    tag = "passed" if passed else "failed"
    self.count[tag] += 1
    print(f"  {tag:<{TAG_WIDTH}}{what}" + (f"  ({detail})" if detail else ""))
    return passed

  def note(self ,text):
    for line in text.splitlines():
      print(f"  {'':<{TAG_WIDTH}}{line}")

  def summary(self):
    print("summary:")
    print(f"  {self.count['passed']:>4}  checks passed")
    print(f"  {self.count['failed']:>4}  checks failed")
    return 0 if self.count["failed"] == 0 else 1


# --------------------------------------------------------------------------------
# the work

def tree(root):
  """
  The files under root as {name: path}, the name relative to root with any
  backup time replaced by the placeholder; a name met twice is listed with
  a count, so two backups of one file are seen.
  """
  result = {}
  for path in sorted(p for p in root.rglob("*") if p.is_file() or p.is_symlink()):
    name = TIME_SUFFIX.sub(TIME_PLACEHOLDER ,path.relative_to(root).as_posix())
    if name in result:
      n = 2
      while f"{name} (copy {n})" in result: n += 1
      name = f"{name} (copy {n})"
    result[name] = path
  return result

def snapshot(root):
  "every file under root, by its exact name, with its content, mode and owner"
  result = {}
  for path in sorted(p for p in root.rglob("*") if p.is_file()):
    st = path.lstat()
    result[path.relative_to(root).as_posix()] = (path.read_bytes() ,stat.S_IMODE(st.st_mode) ,st.st_uid)
  return result

def compare(log ,run_name ,work_dpath):
  expected = tree(TEST_DPATH / "expected" / run_name)
  found = {n: p for n ,p in tree(work_dpath).items() if n.startswith("out/")}
  for name in sorted(set(expected) | set(found)):
    what = f"{run_name} {name}"
    if name not in found:
      log.check(False ,what ,"expected, not written"); continue
    if name not in expected:
      log.check(False ,what ,"written, not expected"); continue
    path = found[name]
    problem = []
    if path.read_bytes() != expected[name].read_bytes():
      problem.append(f"content differs from expected/{run_name}/{name}")
    mode = stat.S_IMODE(path.lstat().st_mode)
    want = MODE[run_name].get(name)
    if want is not None and mode != want:
      problem.append(f"mode {mode:04o}, expected {want:04o}")
    if path.lstat().st_uid != os.getuid():
      problem.append(f"owner uid {path.lstat().st_uid}, expected {os.getuid()}")
    log.check(not problem ,what ,"; ".join(problem) or None)

def limit_file_size():
  "run in the child before Man_In_Grey starts: a file size limit, soft and hard, of 1 MiB"
  resource.setrlimit(resource.RLIMIT_FSIZE ,(1 << 20 ,1 << 20))

def run_Man_In_Grey(program ,path ,work_dpath ,*option ,preexec=None):
  command = [str(program) ,"orchestrate" ,str(path) ,*option]
  result = subprocess.run(command ,cwd=work_dpath ,capture_output=True ,text=True ,preexec_fn=preexec)
  return result.returncode ,(result.stdout + result.stderr).strip()

def check_status(log ,what ,status ,want ,output ,want_text=None):
  passed = status == want and (want_text is None or want_text in output)
  detail = None
  if status != want:
    detail = f"exit status {status}, expected {want}"
  elif not passed:
    detail = f"the output does not say {want_text!r}"
  log.check(passed ,what ,detail)
  if not passed and output:
    log.note(output)
  return passed

def make_tree(consumer ,tree):
  """
  A copy of the promoted Man_In_Grey/ and Man_In_Grey_gate/, side by side, in
  tree. The gate refuses a guard in a directory other accounts can write,
  so tree and the directory holding it are made writable by the owner alone.
  """
  tree.mkdir(parents=True)
  for each in (tree.parent ,tree):
    os.chmod(each ,0o755)
  for name in ("Man_In_Grey" ,"Man_In_Grey_gate"):
    (tree / name).mkdir()
    os.chmod(tree / name ,0o755)
    for source in sorted((consumer / name).iterdir()):
      if source.is_file():
        shutil.copy2(source ,tree / name / source.name)

def put_constraint(guard_fpath ,constraint):
  "replace the predicates between the guard's constraint marks with constraint"
  line_list = guard_fpath.read_text(encoding="utf-8").splitlines()
  begin ,end = line_list.index("# constraints begin") ,line_list.index("# constraints end")
  text = "\n".join(line_list[:begin + 1] + ["" ,constraint.strip("\n") ,""] + line_list[end:]) + "\n"
  guard_fpath.unlink()
  guard_fpath.write_text(text ,encoding="utf-8")
  os.chmod(guard_fpath ,0o644)

def write_constraint(tree ,work_dpath):
  "the test's constraints in its copy of guard_file.py, allowing the files in ALLOWED to the person running the test"
  person = getpass.getuser()
  allowed = {(str(work_dpath / d) ,n): (m ,int(p ,8)) for d ,n ,m ,p in ALLOWED}
  text = (
    "# written by the write_file test\n\n"
    f"PERSON = {person!r}\n"
    f"ALLOWED = {allowed!r}\n\n"
    "def is_allowed_account(user_name):\n"
    "  return user_name == PERSON\n\n"
    "def is_allowed_open(directory ,name ,mode ,owner ,permission):\n"
    "  entry = ALLOWED.get((directory ,name))\n"
    "  return entry is not None and mode in entry[0] and owner == PERSON and permission == entry[1]\n\n"
    "def is_allowed_unlink(directory ,name):\n"
    "  entry = ALLOWED.get((directory ,name))\n"
    "  return entry is not None and \"unlink\" in entry[0]\n"
  )
  put_constraint(tree / "Man_In_Grey" / "guard_file.py" ,text)

def test(repo_home):
  consumer = repo_home / "consumer"
  work_dpath = (repo_home / "tester" / "scratchpad" / TEST_NAME).resolve()
  tree = work_dpath / "tree"
  program = tree / "Man_In_Grey" / "Man_In_Grey"
  print(f"run test   in {TEST_DPATH}")
  print(f"  program  {program}")
  print(f"  writes   {work_dpath}")
  log = Log()

  promoted = os.access(consumer / "Man_In_Grey" / "Man_In_Grey" ,os.X_OK)
  if not log.check(promoted ,"Man_In_Grey is promoted"
                   ,None if promoted else "the developer promotes Man_In_Grey and Man_In_Grey_file_gate first"):
    return log.summary()

  if work_dpath.exists():
    shutil.rmtree(work_dpath)
  for rel in OUTPUT_DIR:
    (work_dpath / rel).mkdir(parents=True)
  make_tree(consumer ,tree)
  write_constraint(tree ,work_dpath)
  (work_dpath / "out" / "obsolete.conf").write_text("to be unlinked\n")
  out = work_dpath / "out"

  # run_1 and run_2
  for run_name in ("run_1" ,"run_2"):
    status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer" ,work_dpath)
    if check_status(log ,f"{run_name} Man_In_Grey exits 0" ,status ,0 ,output):
      compare(log ,run_name ,work_dpath)
    else:
      log.note(f"{run_name}: the files were not compared, since Man_In_Grey failed")
      return log.summary()

  # create: once, then refused
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer_create" / "new.py" ,work_dpath)
  check_status(log ,"create Man_In_Grey exits 0" ,status ,0 ,output)
  new = out / "new.conf"
  log.check(new.is_file() and new.read_text() == "made once\n" and stat.S_IMODE(new.stat().st_mode) == 0o600
            ,"create out/new.conf" ,None if new.is_file() else "not written")
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer_create" / "new.py" ,work_dpath)
  check_status(log ,"create again is refused by the filesystem check" ,status ,1 ,output ,"filesystem_broken:")
  log.check(snapshot(out) == before ,"create again changes nothing")

  # a journal the constraints refuse
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer_refused" ,work_dpath)
  check_status(log ,"refused is refused by the constraint check" ,status ,1 ,output ,"constraint_broken:")
  log.check(snapshot(out) == before ,"refused changes nothing, the allowed file included")

  # a composer with a wrong argument
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer_argument" ,work_dpath)
  check_status(log ,"argument fails in the composer" ,status ,2 ,output ,"wrong_mode.py: open: mode 'overwrite'")
  log.check(snapshot(out) == before ,"argument changes nothing")

  # a composer other accounts can write
  writable = work_dpath / "composer_writable"
  writable.mkdir()
  shutil.copy(TEST_DPATH / "composer" / "unbound_conf.py" ,writable / "unbound_conf.py")
  os.chmod(writable / "unbound_conf.py" ,0o664)
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,writable ,work_dpath)
  check_status(log ,"writable composer is refused by the orchestrator" ,status ,2 ,output ,"writable by group or other accounts")
  log.check(snapshot(out) == before ,"writable changes nothing")

  # check_only
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer" ,work_dpath ,"check_only")
  check_status(log ,"check_only is approved by the guard" ,status ,0 ,output ,"approved: guard file check passed")
  log.check(snapshot(out) == before ,"check_only changes nothing")

  # a resource limit the gate cannot raise
  before = snapshot(out)
  status ,output = run_Man_In_Grey(program ,TEST_DPATH / "composer" ,work_dpath ,preexec=limit_file_size)
  check_status(log ,"limit is refused by the gate" ,status ,2 ,output ,"the file size (bytes) limit is 1048576")
  log.check(snapshot(out) == before ,"limit changes nothing")

  return log.summary()

def clean(repo_home):
  work_dpath = repo_home / "tester" / "scratchpad" / TEST_NAME
  print(f"run clean   in {TEST_DPATH}")
  if work_dpath.exists():
    shutil.rmtree(work_dpath)
    print(f"  deleted   {work_dpath}")
  else:
    print(f"  kept      {work_dpath}  (there is nothing to delete)")
  return 0


# --------------------------------------------------------------------------------
# command line

def print_help():
  print(__doc__.strip())
  return 0

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()
  command ,rest = argv[0] ,argv[1:]
  if command not in ("test" ,"clean"):
    print(f"Error: unknown command '{command}'." ,file=sys.stderr)
    print_help()
    return 1
  if rest:
    print(f"Error: {command} is given no arguments." ,file=sys.stderr)
    return 1
  if not os.environ.get("REPO_HOME"):
    print("Error: REPO_HOME is not set; enter the tester role with ./setup tester." ,file=sys.stderr)
    return 1
  repo_home = Path(os.environ["REPO_HOME"]).resolve()
  return test(repo_home) if command == "test" else clean(repo_home)


if __name__ == "__main__":
  try:
    sys.exit(CLI())
  except BrokenPipeError:
    os.dup2(os.open(os.devnull ,os.O_WRONLY) ,sys.stdout.fileno())
    sys.exit(1)
