#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
run

The Emplace-Bio test of Man-In-Grey's example language. It copies the
promoted Man-In-Grey, from $REPO_HOME/consumer, into its scratchpad
directory, puts constraints of its own at the top of the copy's
Emplace_Bio·Guard.py, placing pages in its scratchpad, and runs that copy
through the Emplace_Bio gate, not setuid. It checks:

  page       orchestrate composer/bio.py: <user_name>.html is compared with
             expected/page.html, every text in it escaped, every style one tag,
             and <user_name>.png is the given picture
  jpeg       orchestrate composer_jpeg/bio.py: the JPEG is placed as <user_name>.jpg, and
             the PNG an earlier run placed is removed
  none       orchestrate composer_no-picture/bio.py: the page shows no picture, and the
             JPEG is removed
  check-only orchestrate composer/bio.py with check-only: approved, and nothing changes

and, with journals made without the journal interface and given to the gate
directly, as a program other than the orchestrator could:

  name       a text instruction with a file name as a third argument: refused by
             the well-formed guard, since its format takes two, and the
             language has no way to name a file
  style      a style the language does not have: refused by the language check
  order      text before any paragraph: refused by the language check
  svg        an SVG picture: refused by the content check
  long       more text than is__allowed_text_size allows: refused by the constraint check
  account    an account is__allowed_account does not allow: refused by the constraint check
  link       a page that has been made a symbolic link: refused by the filesystem check

and, with the gate started from a process that left signal state behind,
which survives exec:

  timer      an interval timer set to send SIGALRM partway through: the gate
             cancels it, and the page is placed
  ignored    SIGCHLD ignored, which would keep the gate from learning how the
             guard ended: the gate puts it back, and the page is placed
  pending    SIGTERM blocked and pending: the gate clears the mask, the signal
             ends the gate before it reads the journal, and nothing changes

A refused run is to leave every file as it was.

The test reads consumer/ and writes only in its scratchpad directory,
$REPO_HOME/tester/scratchpad/Emplace-Bio, where it runs its copy of
Man-In-Grey from tree/.

Usage: run <command>
  help | -h | --help   print this message (also printed when given no arguments)
  test                 run the test; the exit status is 0 only when every check passes
  clean                delete the test's scratchpad directory
"""

import sys ,os ,stat ,json ,shutil ,subprocess ,getpass ,urllib.parse ,signal
sys.dont_write_bytecode = True
from pathlib import Path

import cbor2

TEST_NAME = "Emplace-Bio"
TEST__DPATH = Path(__file__).resolve().parent
GATE_NAME = "Man_In_Grey__Gate·Emplace_Bio"


# --------------------------------------------------------------------------------
# the log

TAG_WIDTH = 10

class Log:
  def __init__(self):
    self.count = {"passed": 0 ,"failed": 0}

  def check(self ,passed ,what ,detail=None):
    tag = "passed" if passed else "failed"
    self.count[tag] += 1
    print(f"  {tag:<{TAG_WIDTH}}{what}" + (f"  ({detail})" if detail else ""))
    return passed

  def note(self ,text):
    for line in text.splitlines():
      print(f"  {'':<{TAG_WIDTH}}{line}")

  def summary(self):
    print("summary:")
    print(f"  {self.count['passed']:>4}  checks passed")
    print(f"  {self.count['failed']:>4}  checks failed")
    return 0 if self.count["failed"] == 0 else 1


# --------------------------------------------------------------------------------
# the work

def snapshot(root):
  "every entry in root, by name, with its content or link target, and its mode"
  result = {}
  for path in sorted(root.iterdir()):
    st = path.lstat()
    content = os.readlink(path).encode() if stat.S_ISLNK(st.st_mode) else path.read_bytes()
    result[path.name] = (content ,st.st_mode)
  return result

def check_status(log ,what ,status ,want ,output ,want_text=None):
  passed = status == want and (want_text is None or want_text in output)
  detail = None
  if status != want:
    detail = f"exit status {status}, expected {want}"
  elif not passed:
    detail = f"the output does not say {want_text!r}"
  log.check(passed ,what ,detail)
  if not passed and output:
    log.note(output)
  return passed

def make_tree(consumer ,tree):
  """
  A copy of the promoted Man_In_Grey/ and Man_In_Grey__Gate/, side by side, in
  tree. The gate refuses a guard in a directory other accounts can write,
  so tree and the directory holding it are made writable by the owner alone.
  """
  tree.mkdir(parents=True)
  for each in (tree.parent ,tree):
    os.chmod(each ,0o755)
  for name in ("Man_In_Grey" ,"Man_In_Grey__Gate"):
    (tree / name).mkdir()
    os.chmod(tree / name ,0o755)
    for source in sorted((consumer / name).iterdir()):
      if source.is_file():
        shutil.copy2(source ,tree / name / source.name)

def put_constraint(guard__fpath ,constraint):
  "replace the predicates between the guard's constraint marks with constraint"
  list__line = guard__fpath.read_text(encoding="utf-8").splitlines()
  begin ,end = list__line.index("# constraints begin") ,list__line.index("# constraints end")
  text = "\n".join(list__line[:begin + 1] + ["" ,constraint.strip("\n") ,""] + list__line[end:]) + "\n"
  guard__fpath.unlink()
  guard__fpath.write_text(text ,encoding="utf-8")
  os.chmod(guard__fpath ,0o644)

def write_constraint(tree ,work__dpath ,account ,text__max_bytes=8192):
  "the test's constraints in its copy of Emplace_Bio·Guard.py, giving account a page in work__dpath/bio"
  text = (
    "# written by the Emplace-Bio test\n\n"
    "def is__allowed_account(user_name):\n"
    f"  return user_name == {account!r}\n\n"
    "def is__allowed_text_size(byte_count):\n"
    f"  return byte_count <= {text__max_bytes}\n\n"
    "def is__allowed_picture_size(byte_count):\n"
    "  return byte_count <= 1 << 20\n\n"
    "def page_directory():\n"
    f"  return {str(work__dpath / 'bio')!r}\n"
  )
  put_constraint(tree / "Man_In_Grey" / "Emplace_Bio·Guard.py" ,text)

def run__Man_In_Grey(program ,gate ,path ,work__dpath ,*option):
  command = [str(program) ,"orchestrate" ,str(path) ,"gate" ,str(gate) ,*option]
  result = subprocess.run(command ,cwd=work__dpath ,capture_output=True ,text=True)
  return result.returncode ,(result.stdout + result.stderr).strip()

def run_gate(gate ,journal_bytes ,preexec=None):
  """
  A journal given to the gate directly, with no orchestrator. preexec runs in
  the gate's process before exec, to leave state behind as an invoking
  program could.
  """
  result = subprocess.run([str(gate) ,"admit"] ,input=journal_bytes ,capture_output=True ,preexec_fn=preexec)
  return result.returncode ,(result.stdout + result.stderr).decode("utf-8" ,"replace").strip()

# state an invoking program can leave behind, which survives exec

def leave_timer():
  "SIGALRM in 50 milliseconds, while the guard is still starting"
  signal.setitimer(signal.ITIMER_REAL ,0.05)

def leave_sigchld_ignored():
  signal.signal(signal.SIGCHLD ,signal.SIG_IGN)

def leave_sigterm_pending():
  signal.pthread_sigmask(signal.SIG_BLOCK ,{signal.SIGTERM})
  os.kill(os.getpid() ,signal.SIGTERM)

def hand_made(definition_hash ,instruction__list):
  """
  A journal of the Emplace_Bio language holding the instructions given as
  (operation ,[value ...]), every value a literal, made as data and encoded,
  with no journal interface to check it.
  """
  return cbor2.dumps({
    "version": 4
    ,"instruction_language": "Emplace_Bio"
    ,"definition_hash": definition_hash
    ,"meta": {}
    ,"list__variable": []
    ,"result": None
    ,"list__instruction": [{"operation": o ,"list__argument": [["literal" ,v] for v in value]} for o ,value in instruction__list]
  } ,canonical=True)

def good_page(*extra):
  return [("display_name" ,["A. Tester"]) ,("paragraph" ,[]) ,("text" ,["Hello." ,[]]) ,*extra]

def test(repo_home):
  consumer = repo_home / "consumer"
  work__dpath = (repo_home / "tester" / "scratchpad" / TEST_NAME).resolve()
  tree = work__dpath / "tree"
  program = tree / "Man_In_Grey" / "Man-In-Grey"
  gate = tree / "Man_In_Grey__Gate" / GATE_NAME
  print(f"run test   in {TEST__DPATH}")
  print(f"  program  {program}")
  print(f"  gate     {gate}")
  print(f"  writes   {work__dpath}")
  log = Log()

  promoted = os.access(consumer / "Man_In_Grey" / "Man-In-Grey" ,os.X_OK) and os.access(consumer / "Man_In_Grey__Gate" / GATE_NAME ,os.X_OK)
  if not log.check(promoted ,"Man-In-Grey and the Emplace_Bio gate are promoted"
                   ,None if promoted else f"the developer promotes Man-In-Grey and {GATE_NAME} first"):
    return log.summary()

  if work__dpath.exists():
    shutil.rmtree(work__dpath)
  (work__dpath / "bio").mkdir(parents=True)
  make_tree(consumer ,tree)
  # the journals the test makes by hand carry the hash of the copy's definition, so it is imported once the copy exists
  sys.path.insert(0 ,str(tree / "Man_In_Grey"))
  import importlib ,Language
  language_module = importlib.import_module("Emplace_Bio·Language")
  definition_hash = Language.Definition(language_module.NAME ,language_module.DEFINITION).hash
  person = getpass.getuser()
  write_constraint(tree ,work__dpath ,person)
  bio = work__dpath / "bio"
  page__fpath ,png ,jpg = bio / f"{person}.html" ,bio / f"{person}.png" ,bio / f"{person}.jpg"

  # page
  status ,output = run__Man_In_Grey(program ,gate ,TEST__DPATH / "composer" / "bio.py" ,work__dpath)
  if not check_status(log ,"page Man-In-Grey exits 0" ,status ,0 ,output):
    return log.summary()
  expected = (TEST__DPATH / "expected" / "page.html").read_text(encoding="utf-8").replace("USER_NAME" ,urllib.parse.quote(person))
  found = page__fpath.read_text(encoding="utf-8") if page__fpath.is_file() else None
  log.check(found == expected ,f"page {person}.html is expected/page.html"
            ,None if found == expected else ("not written" if found is None else "content differs"))
  log.check(found is not None and "<script" not in found and "&lt;script&gt;" in found ,"page text that looks like markup is escaped")
  log.check(png.is_file() and png.read_bytes() == (TEST__DPATH / "picture.png").read_bytes() ,f"page {person}.png is the given picture")
  modes = [stat.S_IMODE(p.stat().st_mode) for p in (page__fpath ,png) if p.exists()]
  log.check(modes == [0o644 ,0o644] ,"page files have permission 0644" ,None if modes == [0o644 ,0o644] else f"{[oct(m) for m in modes]}")

  # jpeg, then no picture
  status ,output = run__Man_In_Grey(program ,gate ,TEST__DPATH / "composer_jpeg" / "bio.py" ,work__dpath)
  check_status(log ,"jpeg Man-In-Grey exits 0" ,status ,0 ,output)
  log.check(jpg.is_file() and not png.exists() and f'src="{urllib.parse.quote(person)}.jpg"' in page__fpath.read_text()
            ,"jpeg places the JPEG and removes the PNG")
  status ,output = run__Man_In_Grey(program ,gate ,TEST__DPATH / "composer_no-picture" / "bio.py" ,work__dpath)
  check_status(log ,"none Man-In-Grey exits 0" ,status ,0 ,output)
  log.check(not jpg.exists() and not png.exists() and "<img" not in page__fpath.read_text() ,"none removes the picture")

  # check-only
  before = snapshot(bio)
  status ,output = run__Man_In_Grey(program ,gate ,TEST__DPATH / "composer" / "bio.py" ,work__dpath ,"check-only")
  check_status(log ,"check-only is approved by the guard" ,status ,0 ,output ,"approved: guard Emplace_Bio check passed")
  log.check(snapshot(bio) == before ,"check-only changes nothing")

  # journals given to the gate directly
  svg = (TEST__DPATH / "picture.svg").read_bytes()
  list__case = (
    ("name" ,good_page(("text" ,["x" ,[] ,"/etc/passwd"])) ,{} ,"wellformed-broken:")
    ,("style" ,good_page(("text" ,["x" ,["blink"]])) ,{} ,"language-broken:")
    ,("order" ,[("display_name" ,["A. Tester"]) ,("text" ,["x" ,[]]) ,("paragraph" ,[]) ,("text" ,["y" ,[]])]
      ,{} ,"language-broken:")
    ,("svg" ,good_page(("picture" ,[svg])) ,{} ,"content-broken:")
    ,("long" ,good_page() ,{"text__max_bytes": 10} ,"constraint-broken:")
    ,("account" ,good_page() ,{"account": "nobody_at_all"} ,"constraint-broken:")
  )
  for name ,instruction__list ,variation ,want in list__case:
    write_constraint(tree ,work__dpath ,variation.get("account" ,person) ,variation.get("text__max_bytes" ,8192))
    before = snapshot(bio)
    status ,output = run_gate(gate ,hand_made(definition_hash ,instruction__list))
    check_status(log ,f"{name} is refused by the {want[:-len('-broken:')]} check" ,status ,1 ,output ,want)
    log.check(snapshot(bio) == before ,f"{name} changes nothing")
  write_constraint(tree ,work__dpath ,person)

  # signal state left behind by the invoking program
  for name ,preexec ,content in (
    ("timer" ,leave_timer ,"Placed under a timer.")
    ,("ignored" ,leave_sigchld_ignored ,"Placed with SIGCHLD ignored.")
  ):
    journal = hand_made(definition_hash ,[("display_name" ,["A. Tester"]) ,("paragraph" ,[]) ,("text" ,[content ,[]])])
    status ,output = run_gate(gate ,journal ,preexec)
    check_status(log ,f"{name} is interpreted" ,status ,0 ,output ,"interpreted:")
    log.check(page__fpath.is_file() and content in page__fpath.read_text() ,f"{name} places the page")
  before = snapshot(bio)
  status ,output = run_gate(gate ,hand_made(definition_hash ,good_page()) ,leave_sigterm_pending)
  log.check(status == -signal.SIGTERM and "received:" not in output ,"pending ends the gate before it reads the journal"
            ,None if status == -signal.SIGTERM else f"exit status {status}")
  log.check(snapshot(bio) == before ,"pending changes nothing")

  # a page made a symbolic link
  target = work__dpath / "elsewhere.html"
  target.write_text("not to be overwritten\n")
  page__fpath.unlink()
  page__fpath.symlink_to(target)
  before = snapshot(bio)
  status ,output = run_gate(gate ,hand_made(definition_hash ,good_page()))
  check_status(log ,"link is refused by the filesystem check" ,status ,1 ,output ,"filesystem-broken:")
  log.check(snapshot(bio) == before and target.read_text() == "not to be overwritten\n" ,"link changes nothing")

  return log.summary()

def clean(repo_home):
  work__dpath = repo_home / "tester" / "scratchpad" / TEST_NAME
  print(f"run clean   in {TEST__DPATH}")
  if work__dpath.exists():
    shutil.rmtree(work__dpath)
    print(f"  deleted   {work__dpath}")
  else:
    print(f"  kept      {work__dpath}  (there is nothing to delete)")
  return 0


# --------------------------------------------------------------------------------
# command line

def print_help():
  print(__doc__.strip())
  return 0

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()
  command ,rest = argv[0] ,argv[1:]
  if command not in ("test" ,"clean"):
    print(f"Error: unknown command '{command}'." ,file=sys.stderr)
    print_help()
    return 1
  if rest:
    print(f"Error: {command} is given no arguments." ,file=sys.stderr)
    return 1
  if not os.environ.get("REPO_HOME"):
    print("Error: REPO_HOME is not set; enter the tester role with ./setup tester." ,file=sys.stderr)
    return 1
  repo_home = Path(os.environ["REPO_HOME"]).resolve()
  return test(repo_home) if command == "test" else clean(repo_home)


if __name__ == "__main__":
  try:
    sys.exit(CLI())
  except BrokenPipeError:
    os.dup2(os.open(os.devnull ,os.O_WRONLY) ,sys.stdout.fileno())
    sys.exit(1)
