#!/usr/bin/env python3
# -*- mode: python; coding: utf-8; python-indent-offset: 2; indent-tabs-mode: nil -*-
"""
run

The smoke test of Man-In-Grey, run through the Smoke language. It copies
the promoted Man-In-Grey, from $REPO_HOME/consumer, into its scratchpad
directory, puts constraints of its own at the top of the copy's
Smoke·Guard.py, allowing the files it expects, and runs that copy through
the Smoke language's gate, not setuid. The Smoke language is not for use
on a system; it is here to exercise the gate, the guard and the
interpreter. It checks:

  run_1      orchestrate composer/config.py: each file written, and
             out/obsolete.conf, made by the test beforehand, unlinked; the
             files are compared with expected/run_1, and the result the gate
             hands back on descriptor 3 is the summary of three files opened
             and one removed
  run_2      orchestrate composer/config.py again: replace-keep files kept as backups named
             <file>.YYYYMMDDTHHMMSSZ, the replace file overwritten with no
             backup; compared with expected/run_2
  create     orchestrate composer_create/new.py: a file opened in create mode is written
             once, and a second run is refused by the guard's filesystem check
  refused    orchestrate composer_refused/allowed-and-not.py: a journal opening one allowed
             file and one the constraints do not allow is refused whole by the guard's
             constraint check
  type       orchestrate composer_type/wrong-type.py: a literal of the wrong type fails when
             the composer places the instruction, and no journal reaches the gate
  mode       orchestrate composer_mode/wrong-mode.py: a mode the language does not have is
             refused by the guard's language check
  directory  orchestrate composer/, a directory: refused, as this version runs one
             composer, given as a file
  writable   orchestrate a composer other accounts can write: the orchestrator refuses
             to run it
  check-only orchestrate composer/config.py with check-only: the guard approves the journal,
             and the interpreter is not run
  limit      orchestrate composer/config.py with a file size limit the gate cannot raise: the
             gate refuses before starting the guard
  silent     orchestrate composer/config.py through an interpreter that exits 0 without
             writing its verdict line: the gate reports the run failed

and, with journals made without the journal interface and given to the gate
directly, as a program other than the orchestrator could:

  unwritten  a write of a file variable no open wrote: refused by the well-formed
             guard, as the variable is read before it is written
  literal    a write given a literal where the format reads and writes its file:
             refused by the well-formed guard, as a literal cannot be written
  surplus    an unlink with a third argument: refused by the well-formed guard
  undeclared a write of a variable the journal does not declare: refused by the
             well-formed guard
  hash       a journal composed against another definition: refused by the
             well-formed guard
  version    a journal of version 3: the guard cannot read it
  discarded  a journal whose result the gate cannot hand back, since the program
             invoking it left descriptor 3 closed: played, and the result discarded

A refused run is to leave every file as it was. Backup names carry the time
of the run, so names are compared with the time replaced by the letters
YYYYMMDDTHHMMSSZ. Content, mode and owner are compared too.

The test reads consumer/ and writes only in its scratchpad directory,
$REPO_HOME/tester/scratchpad/smoke, where it runs its copy of
Man-In-Grey from tree/.

Usage: run <command>
  help | -h | --help   print this message (also printed when given no arguments)
  test                 run the test; the exit status is 0 only when every check passes
  clean                delete the test's scratchpad directory
"""

import sys ,os ,re ,stat ,json ,shutil ,subprocess ,getpass ,resource
sys.dont_write_bytecode = True
from pathlib import Path

import cbor2

TEST_NAME = "smoke"
GATE_NAME = "Man_In_Grey__Gate·Smoke"
DIRPA__TEST = Path(__file__).resolve().parent

LIST__DIRPR__OUTPUT = ("out" ,"out/net" ,"out/web")

# the files the constraints allow: (directory under the scratchpad, name, modes, permission)
ALLOWED = (
  ("out" ,"unbound_conf" ,["replace-keep"] ,"0444")
  ,("out/net" ,"unbound.conf" ,["replace"] ,"0444")
  ,("out/web" ,"nginx.conf" ,["replace-keep"] ,"0644")
  ,("out" ,"obsolete.conf" ,["unlink"] ,"0644")
  ,("out" ,"new.conf" ,["create"] ,"0600")
)

MODE = {
  "run_1": {
    "out/unbound_conf": 0o444
    ,"out/net/unbound.conf": 0o444
    ,"out/web/nginx.conf": 0o644
  },
  "run_2": {
    "out/unbound_conf": 0o444
    ,"out/unbound_conf.YYYYMMDDTHHMMSSZ": 0o444
    ,"out/net/unbound.conf": 0o444
    ,"out/web/nginx.conf": 0o644
    ,"out/web/nginx.conf.YYYYMMDDTHHMMSSZ": 0o644
  },
}

TIME_SUFFIX = re.compile(r"\.\d{8}T\d{6}Z(\.\d+)?$")
TIME_PLACEHOLDER = ".YYYYMMDDTHHMMSSZ"


# --------------------------------------------------------------------------------
# the log

TAG_WIDTH = 10

class Log:
  def __init__(self):
    self.count = {"passed": 0 ,"failed": 0}

  def check(self ,passed ,what ,detail=None):
    tag = "passed" if passed else "failed"
    self.count[tag] += 1
    print(f"  {tag:<{TAG_WIDTH}}{what}" + (f"  ({detail})" if detail else ""))
    return passed

  def note(self ,text):
    for line in text.splitlines():
      print(f"  {'':<{TAG_WIDTH}}{line}")

  def summary(self):
    print("summary:")
    print(f"  {self.count['passed']:>4}  checks passed")
    print(f"  {self.count['failed']:>4}  checks failed")
    return 0 if self.count["failed"] == 0 else 1


# --------------------------------------------------------------------------------
# the work

def tree(dirp__root):
  """
  The files under root as {name: path}, the name relative to root with any
  backup time replaced by the placeholder; a name met twice is listed with
  a count, so two backups of one file are seen.
  """
  result = {}
  for filep__each in sorted(p for p in dirp__root.rglob("*") if p.is_file() or p.is_symlink()):
    name = TIME_SUFFIX.sub(TIME_PLACEHOLDER ,filep__each.relative_to(dirp__root).as_posix())
    if name in result:
      n = 2
      while f"{name} (copy {n})" in result: n += 1
      name = f"{name} (copy {n})"
    result[name] = filep__each
  return result

def snapshot(dirp__root):
  "every file under root, by its exact name, with its content, mode and owner"
  result = {}
  for filep__each in sorted(p for p in dirp__root.rglob("*") if p.is_file()):
    st = filep__each.lstat()
    result[filep__each.relative_to(dirp__root).as_posix()] = (filep__each.read_bytes() ,stat.S_IMODE(st.st_mode) ,st.st_uid)
  return result

def compare(log ,run_name ,dirpa__work):
  expected = tree(DIRPA__TEST / "expected" / run_name)
  found = {n: p for n ,p in tree(dirpa__work).items() if n.startswith("out/")}
  for name in sorted(set(expected) | set(found)):
    what = f"{run_name} {name}"
    if name not in found:
      log.check(False ,what ,"expected, not written"); continue
    if name not in expected:
      log.check(False ,what ,"written, not expected"); continue
    filep__found = found[name]
    problem = []
    if filep__found.read_bytes() != expected[name].read_bytes():
      problem.append(f"content differs from expected/{run_name}/{name}")
    mode = stat.S_IMODE(filep__found.lstat().st_mode)
    want = MODE[run_name].get(name)
    if want is not None and mode != want:
      problem.append(f"mode {mode:04o}, expected {want:04o}")
    if filep__found.lstat().st_uid != os.getuid():
      problem.append(f"owner uid {filep__found.lstat().st_uid}, expected {os.getuid()}")
    log.check(not problem ,what ,"; ".join(problem) or None)

def limit_file_size():
  "run in the child before Man-In-Grey starts: a file size limit, soft and hard, of 1 MiB"
  resource.setrlimit(resource.RLIMIT_FSIZE ,(1 << 20 ,1 << 20))

def run__Man_In_Grey(fpa__program ,filep__composer ,dirpa__work ,*option ,preexec=None):
  fpa__gate = fpa__program.parent.parent / "Man_In_Grey__Gate" / GATE_NAME
  command = [str(fpa__program) ,"orchestrate" ,str(filep__composer) ,"gate" ,str(fpa__gate) ,*option]
  result = subprocess.run(command ,cwd=dirpa__work ,capture_output=True ,text=True ,preexec_fn=preexec)
  return result.returncode ,(result.stdout + result.stderr).strip()

def run_gate(fpa__gate ,journal_bytes):
  "a journal given to the gate directly, with no orchestrator and descriptor 3 closed"
  result = subprocess.run([str(fpa__gate) ,"admit"] ,input=journal_bytes ,capture_output=True)
  return result.returncode ,(result.stdout + result.stderr).decode("utf-8" ,"replace").strip()

def hand_made(definition_hash ,variable ,list__instruction ,result=None ,version=4):
  "a journal of the Smoke language, made as data and encoded, with no journal interface to check it"
  return cbor2.dumps({
    "version": version
    ,"instruction_language": "Smoke"
    ,"definition_hash": definition_hash
    ,"meta": {}
    ,"list__variable": variable
    ,"result": result
    ,"list__instruction": [{"operation": o ,"list__argument": a} for o ,a in list__instruction]
  } ,canonical=True)

def check_status(log ,what ,status ,want ,output ,want_text=None):
  passed = status == want and (want_text is None or want_text in output)
  detail = None
  if status != want:
    detail = f"exit status {status}, expected {want}"
  elif not passed:
    detail = f"the output does not say {want_text!r}"
  log.check(passed ,what ,detail)
  if not passed and output:
    log.note(output)
  return passed

def make_tree(dirpa__consumer ,dirpa__tree):
  """
  A copy of the promoted Man_In_Grey/ and Man_In_Grey__Gate/, side by side, in
  tree. The gate refuses a guard in a directory other accounts can write,
  so tree and the directory holding it are made writable by the owner alone.
  """
  dirpa__tree.mkdir(parents=True)
  for each in (dirpa__tree.parent ,dirpa__tree):
    os.chmod(each ,0o755)
  for name in ("Man_In_Grey" ,"Man_In_Grey__Gate"):
    (dirpa__tree / name).mkdir()
    os.chmod(dirpa__tree / name ,0o755)
    for filep__source in sorted((dirpa__consumer / name).iterdir()):
      if filep__source.is_file():
        shutil.copy2(filep__source ,dirpa__tree / name / filep__source.name)

def put_constraint(fpa__guard ,constraint):
  "replace the predicates between the guard's constraint marks with constraint"
  list__line = fpa__guard.read_text(encoding="utf-8").splitlines()
  begin ,end = list__line.index("# constraints begin") ,list__line.index("# constraints end")
  text = "\n".join(list__line[:begin + 1] + ["" ,constraint.strip("\n") ,""] + list__line[end:]) + "\n"
  fpa__guard.unlink()
  fpa__guard.write_text(text ,encoding="utf-8")
  os.chmod(fpa__guard ,0o644)

def write_constraint(dirpa__tree ,dirpa__work):
  "the test's constraints in its copy of Smoke·Guard.py, allowing the files in ALLOWED to the person running the test"
  person = getpass.getuser()
  allowed = {(str(dirpa__work / d) ,n): (m ,int(p ,8)) for d ,n ,m ,p in ALLOWED}
  text = (
    "# written by the smoke test\n\n"
    f"PERSON = {person!r}\n"
    f"ALLOWED = {allowed!r}\n\n"
    "def is__allowed_account(user_name):\n"
    "  return user_name == PERSON\n\n"
    "def is__allowed_open(dirpa__target ,filen__target ,mode ,owner ,permission):\n"
    "  entry = ALLOWED.get((dirpa__target ,filen__target))\n"
    "  return entry is not None and mode in entry[0] and owner == PERSON and permission == entry[1]\n\n"
    "def is__allowed_unlink(dirpa__target ,filen__target):\n"
    "  entry = ALLOWED.get((dirpa__target ,filen__target))\n"
    "  return entry is not None and \"unlink\" in entry[0]\n"
  )
  put_constraint(dirpa__tree / "Man_In_Grey" / "Smoke·Guard.py" ,text)

def test(dirpa__repo_home):
  dirpa__consumer = dirpa__repo_home / "consumer"
  dirpa__work = (dirpa__repo_home / "tester" / "scratchpad" / TEST_NAME).resolve()
  dirpa__tree = dirpa__work / "tree"
  fpa__program = dirpa__tree / "Man_In_Grey" / "Man-In-Grey"
  fpa__gate = dirpa__tree / "Man_In_Grey__Gate" / GATE_NAME
  config = DIRPA__TEST / "composer" / "config.py"
  print(f"run test   in {DIRPA__TEST}")
  print(f"  program  {fpa__program}")
  print(f"  writes   {dirpa__work}")
  log = Log()

  promoted = os.access(dirpa__consumer / "Man_In_Grey" / "Man-In-Grey" ,os.X_OK)
  if not log.check(promoted ,"Man-In-Grey is promoted"
                   ,None if promoted else f"the developer promotes Man-In-Grey and {GATE_NAME} first"):
    return log.summary()

  if dirpa__work.exists():
    shutil.rmtree(dirpa__work)
  for rel in LIST__DIRPR__OUTPUT:
    (dirpa__work / rel).mkdir(parents=True)
  make_tree(dirpa__consumer ,dirpa__tree)
  write_constraint(dirpa__tree ,dirpa__work)
  (dirpa__work / "out" / "obsolete.conf").write_text("to be unlinked\n")
  out = dirpa__work / "out"

  # the hand-made journals use the copy's definition, so it is imported once the copy exists
  sys.path.insert(0 ,str(dirpa__tree / "Man_In_Grey"))
  import importlib ,Language
  language_module = importlib.import_module("Smoke·Language")
  definition_hash = Language.Definition(language_module.NAME ,language_module.DEFINITION).hash

  # run_1 and run_2
  for run_name in ("run_1" ,"run_2"):
    status ,output = run__Man_In_Grey(fpa__program ,config ,dirpa__work)
    if check_status(log ,f"{run_name} Man-In-Grey exits 0" ,status ,0 ,output):
      compare(log ,run_name ,dirpa__work)
      if run_name == "run_1":
        want = "result: summary {'count_of__open': 3, 'count_of__unlink': 1}"
        log.check(want in output ,"run_1 result is the summary" ,None if want in output else f"the output does not say {want!r}")
    else:
      log.note(f"{run_name}: the files were not compared, since Man-In-Grey failed")
      return log.summary()

  # create: once, then refused
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer_create" / "new.py" ,dirpa__work)
  check_status(log ,"create Man-In-Grey exits 0" ,status ,0 ,output)
  new = out / "new.conf"
  log.check(new.is_file() and new.read_text() == "made once\n" and stat.S_IMODE(new.stat().st_mode) == 0o600
            ,"create out/new.conf" ,None if new.is_file() else "not written")
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer_create" / "new.py" ,dirpa__work)
  check_status(log ,"create again is refused by the filesystem check" ,status ,1 ,output ,"filesystem-broken:")
  log.check(snapshot(out) == before ,"create again changes nothing")

  # a journal the constraints refuse
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer_refused" / "allowed-and-not.py" ,dirpa__work)
  check_status(log ,"refused is refused by the constraint check" ,status ,1 ,output ,"constraint-broken:")
  log.check(snapshot(out) == before ,"refused changes nothing, the allowed file included")

  # a literal of the wrong type, refused in the composer
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer_type" / "wrong-type.py" ,dirpa__work)
  check_status(log ,"type fails in the composer" ,status ,2 ,output ,"wrong-type.py: @0 open argument 4: the literal is str, not integer")
  log.check(snapshot(out) == before ,"type changes nothing")

  # a mode the language does not have, refused by the guard
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer_mode" / "wrong-mode.py" ,dirpa__work)
  check_status(log ,"mode is refused by the language check" ,status ,1 ,output ,"language-broken: @0 open: mode 'overwrite'")
  log.check(snapshot(out) == before ,"mode changes nothing")

  # a composer directory
  status ,output = run__Man_In_Grey(fpa__program ,DIRPA__TEST / "composer" ,dirpa__work)
  check_status(log ,"directory is refused by the orchestrator" ,status ,2 ,output ,"runs one composer, given as a file")

  # a composer other accounts can write
  writable = dirpa__work / "composer_writable"
  writable.mkdir()
  shutil.copy(config ,writable / "config.py")
  os.chmod(writable / "config.py" ,0o664)
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,writable / "config.py" ,dirpa__work)
  check_status(log ,"writable composer is refused by the orchestrator" ,status ,2 ,output ,"writable by group or other accounts")
  log.check(snapshot(out) == before ,"writable changes nothing")

  # check-only
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,config ,dirpa__work ,"check-only")
  check_status(log ,"check-only is approved by the guard" ,status ,0 ,output ,"approved: guard Smoke check passed")
  log.check(snapshot(out) == before ,"check-only changes nothing")

  # a resource limit the gate cannot raise
  before = snapshot(out)
  status ,output = run__Man_In_Grey(fpa__program ,config ,dirpa__work ,preexec=limit_file_size)
  check_status(log ,"limit is refused by the gate" ,status ,2 ,output ,"the file size (bytes) limit is 1048576")
  log.check(snapshot(out) == before ,"limit changes nothing")

  # an interpreter that exits 0 without its verdict line
  interpreter = dirpa__tree / "Man_In_Grey" / "Smoke·Interpreter.py"
  text = interpreter.read_text(encoding="utf-8")
  verdict_line = '  sys.stdout.write("interpreter Smoke journal played\\n")\n'
  if verdict_line not in text:
    log.check(False ,"silent finds the verdict line to remove" ,"Smoke·Interpreter.py has changed")
  interpreter.unlink()
  interpreter.write_text(text.replace(verdict_line ,"  pass\n") ,encoding="utf-8")
  os.chmod(interpreter ,0o644)
  status ,output = run__Man_In_Grey(fpa__program ,config ,dirpa__work)
  check_status(log ,"silent is reported failed by the gate" ,status ,2 ,output ,"without writing the one line 'interpreter Smoke journal played'")
  interpreter.unlink()
  interpreter.write_text(text ,encoding="utf-8")
  os.chmod(interpreter ,0o644)

  # journals given to the gate directly
  out_text = str(out)
  person = getpass.getuser()
  open_web = ("open" ,[["literal" ,out_text + "/web"] ,["literal" ,"nginx.conf"] ,["literal" ,"replace-keep"]
                     ,["literal" ,person] ,["literal" ,0o644] ,["variable" ,"f"]])
  list__case = (
    ("unwritten" ,hand_made(definition_hash ,[["f" ,"file"]] ,[("write" ,[["variable" ,"f"] ,["literal" ,b"x"]])])
     ,1 ,"read before any instruction writes it")
    ,("literal" ,hand_made(definition_hash ,[] ,[("write" ,[["literal" ,0] ,["literal" ,b"x"]])])
      ,1 ,"a literal is given where the format writes (in-out)")
    ,("surplus" ,hand_made(definition_hash ,[] ,[("unlink" ,[["literal" ,out_text] ,["literal" ,"obsolete.conf"] ,["literal" ,"x"]])])
      ,1 ,"3 arguments; the format takes 2")
    ,("undeclared" ,hand_made(definition_hash ,[["f" ,"file"]] ,[open_web ,("write" ,[["variable" ,"g"] ,["literal" ,b"x"]])])
      ,1 ,"the variable 'g' is not declared")
    ,("hash" ,hand_made("0" * 64 ,[] ,[("unlink" ,[["literal" ,out_text] ,["literal" ,"obsolete.conf"]])])
      ,1 ,"composed against another definition")
    ,("version" ,hand_made(definition_hash ,[] ,[] ,version=3) ,2 ,"journal-unreadable: journal version 3")
  )
  for name ,journal_bytes ,want_status ,want_text in list__case:
    before = snapshot(out)
    status ,output = run_gate(fpa__gate ,journal_bytes)
    check_status(log ,f"{name} is refused" ,status ,want_status ,output ,want_text)
    log.check(snapshot(out) == before ,f"{name} changes nothing")
  status ,output = run_gate(fpa__gate ,hand_made(definition_hash ,[["s" ,"summary"]] ,[("summary" ,[["variable" ,"s"]])] ,result="s"))
  check_status(log ,"discarded is played, its result discarded" ,status ,0 ,output ,"result-discarded:")

  return log.summary()

def clean(dirpa__repo_home):
  dirpa__work = dirpa__repo_home / "tester" / "scratchpad" / TEST_NAME
  print(f"run clean   in {DIRPA__TEST}")
  if dirpa__work.exists():
    shutil.rmtree(dirpa__work)
    print(f"  deleted   {dirpa__work}")
  else:
    print(f"  kept      {dirpa__work}  (there is nothing to delete)")
  return 0


# --------------------------------------------------------------------------------
# command line

def print_help():
  print(__doc__.strip())
  return 0

def CLI(argv=None):
  if argv is None: argv = sys.argv[1:]
  if not argv or argv[0] in ("help" ,"-h" ,"--help"): return print_help()
  command ,rest = argv[0] ,argv[1:]
  if command not in ("test" ,"clean"):
    print(f"Error: unknown command '{command}'." ,file=sys.stderr)
    print_help()
    return 1
  if rest:
    print(f"Error: {command} is given no arguments." ,file=sys.stderr)
    return 1
  if not os.environ.get("REPO_HOME"):
    print("Error: REPO_HOME is not set; enter the tester role with ./setup tester." ,file=sys.stderr)
    return 1
  dirpa__repo_home = Path(os.environ["REPO_HOME"]).resolve()
  return test(dirpa__repo_home) if command == "test" else clean(dirpa__repo_home)


if __name__ == "__main__":
  try:
    sys.exit(CLI())
  except BrokenPipeError:
    os.dup2(os.open(os.devnull ,os.O_WRONLY) ,sys.stdout.fileno())
    sys.exit(1)
